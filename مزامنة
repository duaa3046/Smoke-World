    <div id="toast-container" class="fixed bottom-20 md:bottom-6 left-4 right-4 md:left-auto md:right-6 z-50 pointer-events-none flex flex-col gap-2 items-center md:items-end"></div>

    <script>
        const CORRECT_PIN = '2006';

        // ضعي هنا Bin ID و API Key الخاصين بك من موقع jsonbin.io لكي يعملا تلقائياً على جميع الأجهزة بدون الحاجة لإدخالهما يدوياً
        const DEFAULT_BIN_ID = '6afcacf0ac6210605a8fa46d'; 
        const DEFAULT_API_KEY = '$2a$10$BC2JOodEkhUR/N9pza2KhOEP31Mje.OYxMUTx3kw8xHzvhvHwWv9m'; 

        const STORAGE_KEYS = {
            PRODUCTS: 'dukhaniyat_products_v2',
            SALES: 'dukhaniyat_sales_v2',
            SOUND: 'dukhaniyat_sound_v1',
            AUTH: 'dukhaniyat_auth_v1',
            BIN_ID: 'dukhaniyat_bin_id_v1',
            API_KEY: 'dukhaniyat_api_key_v1'
        };

        const DEFAULT_PRODUCTS = [
            { id: 'p1', name: 'فوزل 12K', category: 'فيب', cost: 10000, price: 13000, emoji: '🍎', image: null },
            { id: 'p2', name: 'فوزل 40K', category: 'معسل', cost: 9000, price: 12000, emoji: '🍇', image: null },
            { id: 'p3', name: 'فحم جوز الهند كوكو 1 كيلو', category: 'فحم', cost: 4500, price: 6000, emoji: '🔥', image: null },
            { id: 'p4', name: 'سحبة فيب جاهزة 5000 سحبة', category: 'فيب', cost: 14000, price: 18000, emoji: '💨', image: null },
            { id: 'p5', name: 'نكهة فيب سولت 30 مل', category: 'فيب', cost: 11000, price: 15000, emoji: '🧪', image: null },
            { id: 'p6', name: 'رأس شيشة سيليكون + حراري', category: 'إكسسوارات', cost: 5000, price: 8000, emoji: '🛠️', image: null },
            { id: 'p7', name: 'صوندة شيشة استخدام مرة واحدة', category: 'إكسسوارات', cost: 1000, price: 2000, emoji: '🛠️', image: null },
            { id: 'p8', name: 'سلفون (قصدير) مثقب جاهز', category: 'إكسسوارات', cost: 1500, price: 2500, emoji: '🔥', image: null }
        ];

        let products = [];
        let sales = [];
        let currentPOSCategory = 'الكل';
        let currentReportPeriod = 'daily';
        let selectedEmoji = '🍎';
        let uploadedBase64Image = null;
        let soundEnabled = true;
        let isSyncing = false;
        let syncTimer = null;

        function getCloudCredentials() {
            const binId = (localStorage.getItem(STORAGE_KEYS.BIN_ID) || DEFAULT_BIN_ID).trim();
            const apiKey = (localStorage.getItem(STORAGE_KEYS.API_KEY) || DEFAULT_API_KEY).trim();
            return { binId, apiKey };
        }

        function updateSyncBadge(status, text) {
            const dot = document.getElementById('sync-dot');
            const label = document.getElementById('sync-text');
            if (!dot || !label) return;
            label.textContent = text;
            if (status === 'ok') {
                dot.className = 'w-2 h-2 rounded-full bg-emerald-400';
            } else if (status === 'syncing') {
                dot.className = 'w-2 h-2 rounded-full bg-amber-400 animate-ping';
            } else if (status === 'error') {
                dot.className = 'w-2 h-2 rounded-full bg-red-500';
            } else {
                dot.className = 'w-2 h-2 rounded-full bg-slate-400';
            }
        }

        async function pullFromCloud(manual = false) {
            const { binId, apiKey } = getCloudCredentials();
            if (!binId || !apiKey) {
                updateSyncBadge('offline', 'تخزين محلي فقط');
                if (manual) showToast('يرجى إدخال Bin ID و API Key في تبويب المنتجات');
                return;
            }
            if (isSyncing) return;
            isSyncing = true;
            updateSyncBadge('syncing', 'جاري المزامنة...');
            const icon = document.getElementById('sync-refresh-icon');
            if (icon) icon.classList.add('animate-spin');

            try {
                const res = await fetch(`https://api.jsonbin.io/v3/b/${binId}/latest`, {
                    headers: {
                        'X-Master-Key': apiKey,
                        'X-Access-Key': apiKey
                    }
                });
                if (!res.ok) throw new Error('HTTP ' + res.status);
                const json = await res.json();
                const record = json.record || {};

                if (Array.isArray(record.products) && record.products.length > 0) {
                    products = record.products;
                    localStorage.setItem(STORAGE_KEYS.PRODUCTS, JSON.stringify(products));
                }
                if (Array.isArray(record.sales)) {
                    sales = record.sales;
                    localStorage.setItem(STORAGE_KEYS.SALES, JSON.stringify(sales));
                }

                renderPOSProducts();
                updatePOSTodaySummary();
                renderManageProducts();
                if (!document.getElementById('tab-inventory').classList.contains('hidden')) {
                    renderInventoryReport();
                }
                updateSyncBadge('ok', 'متزامن سحابياً');
                if (manual) showToast('تم تحديث البيانات من السحابة بنجاح');
            } catch (err) {
                console.error(err);
                updateSyncBadge('error', 'خطأ بالمزامنة');
                if (manual) showToast('تعذر الاتصال بالسحابة، تحقق من المفاتيح والإنترنت');
            } finally {
                isSyncing = false;
                if (icon) icon.classList.remove('animate-spin');
            }
        }

        function schedulePushToCloud() {
            clearTimeout(syncTimer);
            syncTimer = setTimeout(() => {
                pushToCloud();
            }, 600);
        }

        async function pushToCloud() {
            const { binId, apiKey } = getCloudCredentials();
            if (!binId || !apiKey) {
                updateSyncBadge('offline', 'تخزين محلي فقط');
                return;
            }
            updateSyncBadge('syncing', 'جاري الحفظ...');
            try {
                const res = await fetch(`https://api.jsonbin.io/v3/b/${binId}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Master-Key': apiKey,
                        'X-Access-Key': apiKey
                    },
                    body: JSON.stringify({
                        app: 'DukhaniyatPOS',
                        updatedAt: new Date().toISOString(),
                        products: products,
                        sales: sales
                    })
                });
                if (!res.ok) throw new Error('HTTP ' + res.status);
                updateSyncBadge('ok', 'متزامن سحابياً');
            } catch (err) {
                console.error(err);
                updateSyncBadge('error', 'فشل الرفع للسحابة');
                showToast('تنبيه: تم الحفظ محلياً لكن فشل الرفع للسحابة');
            }
        }

        function saveCloudConfig() {
            const binId = document.getElementById('cfg-bin-id').value.trim();
            const apiKey = document.getElementById('cfg-api-key').value.trim();
            localStorage.setItem(STORAGE_KEYS.BIN_ID, binId);
            localStorage.setItem(STORAGE_KEYS.API_KEY, apiKey);
            if (binId && apiKey) {
                showToast('تم حفظ مفاتيح السحابة، جاري المزامنة...');
                pullFromCloud(true);
            } else {
                updateSyncBadge('offline', 'تخزين محلي فقط');
                showToast('تم مسح إعدادات السحابة');
            }
        }

        function verifyPin() {
            const input = document.getElementById('pin-input').value.trim();
            const err = document.getElementById('pin-error');
            if (input === CORRECT_PIN) {
                localStorage.setItem(STORAGE_KEYS.AUTH, 'true');
                document.getElementById('pin-modal').classList.add('hidden');
                initApp();
            } else {
                err.classList.remove('hidden');
                document.getElementById('pin-input').value = '';
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            const isAuth = localStorage.getItem(STORAGE_KEYS.AUTH);
            if (isAuth === 'true') {
                document.getElementById('pin-modal').classList.add('hidden');
                initApp();
            } else {
                lucide.createIcons();
            }
        });

        const ARABIC_DAYS = ['الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'];

        function getLocalDateStr(dateObj = new Date()) {
            const year = dateObj.getFullYear();
            const month = String(dateObj.getMonth() + 1).padStart(2, '0');
            const day = String(dateObj.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        function formatArabicDayMonth(dateStr) {
            const [y, m, d] = dateStr.split('-').map(Number);
            const dateObj = new Date(y, m - 1, d);
            return `${ARABIC_DAYS[dateObj.getDay()]} ${m}/${d}`;
        }

        function formatFullArabicDate(dateStr) {
            const [y, m, d] = dateStr.split('-').map(Number);
            const dateObj = new Date(y, m - 1, d);
            return `${ARABIC_DAYS[dateObj.getDay()]} ${d}/${m}/${y}`;
        }

        function formatIQD(amount) {
            return Number(amount || 0).toLocaleString('en-US') + ' د.ع';
        }

        function playSaleSound() {
            if (!soundEnabled) return;
            try {
                if (Tone.context.state !== 'running') Tone.start();
                const synth = new Tone.Synth({
                    oscillator: { type: 'sine' },
                    envelope: { attack: 0.005, decay: 0.1, sustain: 0, release: 0.1 }
                }).toDestination();
                synth.triggerAttackRelease('C6', '32n');
            } catch (e) {}
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            localStorage.setItem(STORAGE_KEYS.SOUND, JSON.stringify(soundEnabled));
            updateSoundIcon();
            showToast(soundEnabled ? 'تم تفعيل صوت النقر' : 'تم كتم الصوت');
        }

        function updateSoundIcon() {
            const btn = document.getElementById('sound-toggle-btn');
            btn.innerHTML = soundEnabled ? '<i data-lucide="volume-2" class="w-5 h-5"></i>' : '<i data-lucide="volume-x" class="w-5 h-5 text-slate-400"></i>';
            lucide.createIcons();
        }

        function initApp() {
            const savedProducts = localStorage.getItem(STORAGE_KEYS.PRODUCTS);
            if (savedProducts) {
                products = JSON.parse(savedProducts);
            } else {
                products = [...DEFAULT_PRODUCTS];
                localStorage.setItem(STORAGE_KEYS.PRODUCTS, JSON.stringify(products));
            }

            const savedSales = localStorage.getItem(STORAGE_KEYS.SALES);
            sales = savedSales ? JSON.parse(savedSales) : [];

            const savedSound = localStorage.getItem(STORAGE_KEYS.SOUND);
            if (savedSound !== null) soundEnabled = JSON.parse(savedSound);
            updateSoundIcon();

            const { binId, apiKey } = getCloudCredentials();
            document.getElementById('cfg-bin-id').value = binId;
            document.getElementById('cfg-api-key').value = apiKey;

            const todayStr = getLocalDateStr();
            document.getElementById('header-date').textContent = formatFullArabicDate(todayStr);
            document.getElementById('report-date-input').value = todayStr;

            renderPOSProducts();
            updatePOSTodaySummary();
            renderManageProducts();
            lucide.createIcons();

            // جلب أحدث البيانات من السحابة عند الفتح، وتحديثها تلقائياً كل 25 ثانية
            pullFromCloud(false);
            setInterval(() => {
                if (!document.hidden) pullFromCloud(false);
            }, 25000);
        }

        function saveProducts() {
            localStorage.setItem(STORAGE_KEYS.PRODUCTS, JSON.stringify(products));
            schedulePushToCloud();
        }

        function saveSales() {
            localStorage.setItem(STORAGE_KEYS.SALES, JSON.stringify(sales));
            updatePOSTodaySummary();
            schedulePushToCloud();
        }

        function switchTab(tabName) {
            ['pos', 'inventory', 'manage'].forEach(t => {
                document.getElementById(`tab-${t}`).classList.add('hidden');
            });
            document.getElementById(`tab-${tabName}`).classList.remove('hidden');

            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('bg-amber-500', 'text-slate-900', 'shadow');
                btn.classList.add('text-slate-300', 'hover:text-white', 'hover:bg-slate-700');
            });
            const activeDesktop = document.getElementById(`nav-desktop-${tabName}`);
            activeDesktop.classList.remove('text-slate-300', 'hover:text-white', 'hover:bg-slate-700');
            activeDesktop.classList.add('bg-amber-500', 'text-slate-900', 'shadow');

            document.querySelectorAll('.mob-nav-btn').forEach(btn => {
                btn.classList.remove('text-amber-400', 'bg-slate-800');
                btn.classList.add('text-slate-400');
            });
            const activeMobile = document.getElementById(`nav-mobile-${tabName}`);
