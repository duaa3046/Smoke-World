<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>نظام البيع والجرد الذكي | عالم الدخان</title>
    <!-- خط القاهرة العربي العصري -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <!-- مكتبة Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- أيقونات Lucide -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- مكتبة Tone.js للتأثيرات الصوتية الخفيفة عند البيع -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <!-- مكتبة حفظ التقرير كصورة -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Cairo', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#fffbeb',
                            100: '#fef3c7',
                            500: '#f59e0b',
                            600: '#d97706',
                            700: '#b45309',
                        },
                        dark: {
                            900: '#0f172a',
                            800: '#1e293b',
                            700: '#334155',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f1f5f9;
            -webkit-tap-highlight-color: transparent;
            user-select: none;
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }
        .product-card:active {
            transform: scale(0.96);
        }
        @media print {
            body * {
                visibility: hidden;
            }
            #printable-report, #printable-report * {
                visibility: visible;
            }
            #printable-report {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                background: white !important;
                color: black !important;
                padding: 20px;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body class="text-slate-800 pb-24 md:pb-8">

    <!-- نافذة إدخال رمز المرور (PIN Gate) للحماية والمزامنة الخاصة -->
    <div id="pin-modal" class="fixed inset-0 bg-slate-950 z-50 flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-sm rounded-3xl p-6 shadow-2xl text-center space-y-6">
            <div class="w-16 h-16 bg-amber-100 text-amber-600 rounded-2xl mx-auto flex items-center justify-center shadow-inner">
                <i data-lucide="lock" class="w-8 h-8"></i>
            </div>
            <div>
                <h2 class="text-xl font-black text-slate-900">عالم الدخان - النظام الآمن</h2>
                <p class="text-xs text-slate-500 font-bold mt-1">الرجاء إدخال رمز المرور الخاص بالمحل للمتابعة</p>
            </div>
            <div class="space-y-3">
                <input type="password" id="pin-input" placeholder="أدخل الرمز السري" maxlength="8" onkeyup="if(event.key==='Enter') verifyPin()" class="w-full bg-slate-50 border-2 border-slate-200 rounded-2xl px-4 py-3.5 text-center text-xl font-black tracking-widest focus:outline-none focus:border-amber-500 focus:bg-white transition">
                <p id="pin-error" class="text-xs text-red-500 font-bold hidden">رمز المرور غير صحيح، حاول مرة أخرى.</p>
                <button onclick="verifyPin()" class="w-full bg-slate-900 hover:bg-slate-800 active:scale-98 text-amber-400 font-black py-3.5 rounded-2xl shadow-lg transition">
                    دخول للنظام
                </button>
            </div>
        </div>
    </div>

    <!-- الشريط العلوي (Header) -->
    <header class="bg-slate-900 text-white sticky top-0 z-40 shadow-lg border-b border-slate-800">
        <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 to-orange-600 flex items-center justify-center shadow-md">
                    <i data-lucide="flame" class="w-6 h-6 text-white"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="font-extrabold text-lg md:text-xl leading-tight tracking-wide text-amber-400">عالم الدخان</h1>
                        <span id="sync-status-badge" class="text-[10px] px-2 py-0.5 rounded-full bg-slate-800 text-slate-300 font-bold flex items-center gap-1">
                            <span id="sync-dot" class="w-2 h-2 rounded-full bg-amber-400"></span>
                            <span id="sync-text">جاري الاتصال...</span>
                        </span>
                    </div>
                    <p id="header-date" class="text-xs text-slate-300 font-semibold">جاري تحميل التاريخ...</p>
                </div>
            </div>

            <!-- قائمة التنقل لسطح المكتب والتابلت -->
            <nav class="hidden md:flex items-center gap-2 bg-slate-800 p-1.5 rounded-2xl">
                <button onclick="switchTab('pos')" id="nav-desktop-pos" class="nav-btn flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm transition-all bg-amber-500 text-slate-900 shadow">
                    <i data-lucide="shopping-bag" class="w-4 h-4"></i>
                    <span>البيع السريع</span>
                </button>
                <button onclick="switchTab('inventory')" id="nav-desktop-inventory" class="nav-btn flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm transition-all text-slate-300 hover:text-white hover:bg-slate-700">
                    <i data-lucide="bar-chart-3" class="w-4 h-4"></i>
                    <span>الجرد والتقارير</span>
                </button>
                <button onclick="switchTab('manage')" id="nav-desktop-manage" class="nav-btn flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm transition-all text-slate-300 hover:text-white hover:bg-slate-700">
                    <i data-lucide="package-plus" class="w-4 h-4"></i>
                    <span>إدارة المنتجات</span>
                </button>
            </nav>

            <!-- أزرار التحديث السريع والصوت -->
            <div class="flex items-center gap-2">
                <button onclick="pullFromCloud(true)" title="تحديث البيانات من السحابة الآن" class="p-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-emerald-400 transition">
                    <i data-lucide="refresh-cw" id="sync-refresh-icon" class="w-5 h-5"></i>
                </button>
                <button onclick="toggleSound()" id="sound-toggle-btn" title="تفعيل/كتم صوت النقر" class="p-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-amber-400 transition">
                    <i data-lucide="volume-2" class="w-5 h-5"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- المحتوى الرئيسي -->
    <main class="max-w-7xl mx-auto px-3 md:px-6 pt-4">

        <!-- ========================================== -->
        <!-- 1. قسم البيع السريع (POS) -->
        <!-- ========================================== -->
        <section id="tab-pos" class="space-y-4">
            
            <div class="grid grid-cols-3 gap-2 md:gap-4">
                <div class="bg-emerald-50/80 rounded-2xl p-3 md:p-4 border border-emerald-200 shadow-sm flex flex-col justify-between">
                    <span class="text-[10px] md:text-xs font-bold text-emerald-800 block truncate">مبيعات اليوم</span>
                    <span id="pos-today-total" class="text-sm sm:text-lg md:text-2xl font-black text-emerald-600 truncate my-1">0 د.ع</span>
                    <span class="text-[9px] text-emerald-700 font-semibold hidden sm:block">الصندوق الحالي</span>
                </div>

                <div class="bg-white rounded-2xl p-3 md:p-4 border border-slate-200 shadow-sm flex flex-col justify-between">
                    <span class="text-[10px] md:text-xs font-bold text-slate-500 block truncate">القطع المباعة</span>
                    <span id="pos-today-count" class="text-sm sm:text-lg md:text-2xl font-black text-slate-800 truncate my-1">0</span>
                    <span class="text-[9px] text-slate-400 font-semibold hidden sm:block">إجمالي القطع</span>
                </div>

                <button onclick="openTodaySalesModal()" class="bg-slate-900 hover:bg-slate-800 text-white rounded-2xl p-3 md:p-4 shadow-sm flex flex-col justify-between transition active:scale-95 text-right group">
                    <span class="text-[10px] md:text-xs font-bold text-amber-400 block truncate">سجل المبيعات</span>
                    <span class="text-xs sm:text-sm md:text-base font-black text-white truncate my-1 group-hover:text-amber-300 transition">تعديل / حذف</span>
                    <span class="text-[9px] text-slate-300 font-semibold hidden sm:block">إدارة المبيعات</span>
                </button>
            </div>

            <div class="bg-white rounded-2xl p-3 shadow-sm border border-slate-200 space-y-3">
                <div class="relative">
                    <i data-lucide="search" class="w-5 h-5 text-slate-400 absolute right-3.5 top-3.5"></i>
                    <input type="text" id="pos-search" oninput="renderPOSProducts()" placeholder="ابحث عن اسم المعسل، الفحم، الفيب..." class="w-full bg-slate-50 border border-slate-200 rounded-xl pr-11 pl-4 py-3 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition">
                </div>

                <div class="flex items-center gap-2 overflow-x-auto pb-1 no-scrollbar" id="pos-categories">
                    <button onclick="setPOSCategory('الكل')" class="cat-btn active whitespace-nowrap px-4 py-2.5 rounded-xl font-bold text-sm bg-amber-500 text-slate-900 shadow-sm transition">الكل</button>
                    <button onclick="setPOSCategory('معسل')" class="cat-btn whitespace-nowrap px-4 py-2.5 rounded-xl font-bold text-sm bg-slate-100 text-slate-600 hover:bg-slate-200 transition">🍎 معسل</button>
                    <button onclick="setPOSCategory('فحم')" class="cat-btn whitespace-nowrap px-4 py-2.5 rounded-xl font-bold text-sm bg-slate-100 text-slate-600 hover:bg-slate-200 transition">🔥 فحم</button>
                    <button onclick="setPOSCategory('فيب')" class="cat-btn whitespace-nowrap px-4 py-2.5 rounded-xl font-bold text-sm bg-slate-100 text-slate-600 hover:bg-slate-200 transition">💨 فيب ونكهات</button>
                    <button onclick="setPOSCategory('إكسسوارات')" class="cat-btn whitespace-nowrap px-4 py-2.5 rounded-xl font-bold text-sm bg-slate-100 text-slate-600 hover:bg-slate-200 transition">🛠️ إكسسوارات</button>
                    <button onclick="setPOSCategory('نركيلة')" class="cat-btn whitespace-nowrap px-4 py-2.5 rounded-xl font-bold text-sm bg-slate-100 text-slate-600 hover:bg-slate-200 transition">🫧 نركيلة</button>
                </div>
            </div>

            <div id="pos-products-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 md:gap-4"></div>

            <div id="pos-empty-state" class="hidden text-center py-12 bg-white rounded-2xl border border-slate-200">
                <i data-lucide="package-open" class="w-14 h-14 text-slate-300 mx-auto mb-3"></i>
                <p class="text-slate-500 font-bold text-lg">لا توجد منتجات مطابقة لبحثك</p>
                <button onclick="switchTab('manage')" class="mt-4 bg-amber-500 text-slate-900 px-5 py-2.5 rounded-xl font-bold text-sm">إضافة منتج جديد</button>
            </div>
        </section>

        <!-- ========================================== -->
        <!-- 2. قسم الجرد والتقارير -->
        <!-- ========================================== -->
        <section id="tab-inventory" class="hidden space-y-5">
            <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-200 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
                <div class="grid grid-cols-3 gap-2 bg-slate-100 p-1.5 rounded-xl">
                    <button onclick="setReportPeriod('daily')" id="rep-tab-daily" class="rep-tab py-2.5 px-4 rounded-lg font-bold text-sm bg-white text-slate-900 shadow transition">الجرد اليومي</button>
                    <button onclick="setReportPeriod('weekly')" id="rep-tab-weekly" class="rep-tab py-2.5 px-4 rounded-lg font-bold text-sm text-slate-600 hover:text-slate-900 transition">الجرد الأسبوعي</button>
                    <button onclick="setReportPeriod('monthly')" id="rep-tab-monthly" class="rep-tab py-2.5 px-4 rounded-lg font-bold text-sm text-slate-600 hover:text-slate-900 transition">الجرد الشهري</button>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    <div id="daily-date-picker-wrap" class="flex items-center gap-2 bg-slate-50 border border-slate-200 px-3 py-2 rounded-xl">
                        <span class="text-xs font-bold text-slate-500">تاريخ اليوم:</span>
                        <input type="date" id="report-date-input" onchange="renderInventoryReport()" class="bg-transparent font-bold text-sm text-slate-800 focus:outline-none">
                    </div>

                    <button onclick="shareReportWhatsApp()" class="flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 rounded-xl font-bold text-sm shadow-sm transition">
                        <i data-lucide="share-2" class="w-4 h-4"></i>
                        <span>نسخ للواتساب</span>
                    </button>

                    <button onclick="saveReportAsImage()" class="flex items-center gap-2 bg-slate-800 hover:bg-slate-900 text-white px-4 py-2.5 rounded-xl font-bold text-sm shadow-sm transition">
                        <i data-lucide="image" class="w-4 h-4"></i>
                        <span>حفظ الصورة</span>
                    </button>
                </div>
            </div>

            <div id="printable-report" class="space-y-5">
                <div class="bg-gradient-to-l from-slate-900 to-slate-800 text-white rounded-2xl p-5 shadow-md flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <div>
                        <span class="text-xs font-bold text-amber-400">ملخص الحسابات التلقائي</span>
                        <h2 id="report-dynamic-title" class="text-xl md:text-2xl font-black mt-1">الجرد ليوم الأحد</h2>
                    </div>
                    <div id="report-period-subtitle" class="text-sm text-slate-300 font-semibold bg-slate-700/60 px-4 py-2 rounded-xl self-start sm:self-center"></div>
                </div>

                <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
                    <div class="bg-white rounded-2xl p-4 md:p-5 border border-slate-200 shadow-sm">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs md:text-sm font-bold text-slate-500">إجمالي المبيعات (الصندوق)</span>
                            <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                                <i data-lucide="wallet" class="w-5 h-5"></i>
                            </div>
                        </div>
                        <p id="stat-total-sales" class="text-xl md:text-2xl font-black text-slate-900">0 د.ع</p>
                    </div>

                    <div class="bg-white rounded-2xl p-4 md:p-5 border border-slate-200 shadow-sm">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs md:text-sm font-bold text-slate-500">رأس المال (التكلفة الأصلية)</span>
                            <div class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                                <i data-lucide="coins" class="w-5 h-5"></i>
                            </div>
                        </div>
                        <p id="stat-total-cost" class="text-xl md:text-2xl font-black text-amber-600">0 د.ع</p>
                    </div>

                    <div class="bg-emerald-50/70 rounded-2xl p-4 md:p-5 border-2 border-emerald-500/30 shadow-sm">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs md:text-sm font-extrabold text-emerald-800">صافي الربح</span>
                            <div class="w-9 h-9 rounded-xl bg-emerald-500 text-white flex items-center justify-center shadow-sm">
                                <i data-lucide="trending-up" class="w-5 h-5"></i>
                            </div>
                        </div>
                        <p id="stat-net-profit" class="text-xl md:text-2xl font-black text-emerald-600">0 د.ع</p>
                    </div>

                    <div class="bg-white rounded-2xl p-4 md:p-5 border border-slate-200 shadow-sm">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs md:text-sm font-bold text-slate-500">عدد القطع المباعة</span>
                            <div class="w-9 h-9 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center">
                                <i data-lucide="shopping-cart" class="w-5 h-5"></i>
                            </div>
                        </div>
                        <p id="stat-total-items" class="text-xl md:text-2xl font-black text-slate-900">0 قطعة</p>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                    <div class="p-4 border-b border-slate-100 flex items-center justify-between">
                        <h3 class="font-extrabold text-base text-slate-800 flex items-center gap-2">
                            <i data-lucide="table" class="w-5 h-5 text-amber-500"></i>
                            <span>تفاصيل المنتجات المباعة في هذه الفترة</span>
                        </h3>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-right border-collapse">
                            <thead>
                                <tr class="bg-slate-50 text-slate-600 text-xs md:text-sm border-b border-slate-200">
                                    <th class="py-3.5 px-4 font-extrabold">اسم المنتج</th>
                                    <th class="py-3.5 px-3 font-extrabold text-center">الكمية</th>
                                    <th class="py-3.5 px-4 font-extrabold">التكلفة الكلية</th>
                                    <th class="py-3.5 px-4 font-extrabold">المبيعات الكلية</th>
                                    <th class="py-3.5 px-4 font-extrabold text-emerald-700">صافي الربح</th>
                                </tr>
                            </thead>
                            <tbody id="report-table-body" class="divide-y divide-slate-100 text-sm"></tbody>
                        </table>
                    </div>

                    <div id="report-empty-state" class="hidden text-center py-12">
                        <p class="text-slate-400 font-bold text-base">لا توجد مبيعات مسجلة في هذه الفترة حتى الآن.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ========================================== -->
        <!-- 3. قسم إدارة المنتجات -->
        <!-- ========================================== -->
        <section id="tab-manage" class="hidden space-y-6">
            <!-- إعدادات المزامنة السحابية -->
            <div class="bg-slate-900 text-white rounded-2xl p-4 shadow-md space-y-4">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                    <div>
                        <h3 class="font-extrabold text-base text-amber-400 flex items-center gap-2">
                            <i data-lucide="cloud" class="w-5 h-5"></i>
                            <span>إعدادات المزامنة السحابية الفورية (JSONBin)</span>
                        </h3>
                        <p class="text-xs text-slate-300 mt-1">أدخلي مفاتيح الربط لمرة واحدة لمزامنة المنتجات والمبيعات لحظياً بين جهازك وأجهزة إخوتك.</p>
                    </div>
                    <div class="flex items-center gap-2 w-full sm:w-auto">
                        <button onclick="exportBackupJSON()" class="flex-1 sm:flex-none flex items-center justify-center gap-2 bg-slate-700 hover:bg-slate-600 text-white px-3.5 py-2 rounded-xl font-bold text-xs transition">
                            <i data-lucide="download" class="w-4 h-4"></i>
                            <span>تصدير JSON</span>
                        </button>
                        <label class="flex-1 sm:flex-none flex items-center justify-center gap-2 bg-slate-700 hover:bg-slate-600 text-white px-3.5 py-2 rounded-xl font-bold text-xs cursor-pointer transition">
                            <i data-lucide="upload" class="w-4 h-4"></i>
                            <span>استعادة JSON</span>
                            <input type="file" id="import-json-input" accept=".json" onchange="importBackupJSON(event)" class="hidden">
                        </label>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-12 gap-3 pt-2 border-t border-slate-800">
                    <div class="md:col-span-5">
                        <label class="block text-[11px] font-bold text-slate-400 mb-1">معرف السحابة (Bin ID)</label>
                        <input type="text" id="cfg-bin-id" placeholder="مثال: 673a55e2acd3cb34a8a5b2e1" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs font-mono text-amber-300 focus:outline-none focus:border-amber-500">
                    </div>
                    <div class="md:col-span-5">
                        <label class="block text-[11px] font-bold text-slate-400 mb-1">مفتاح الوصول السري (X-Access-Key أو Master Key)</label>
                        <input type="password" id="cfg-api-key" placeholder="$2a$10$..." class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs font-mono text-amber-300 focus:outline-none focus:border-amber-500">
                    </div>
                    <div class="md:col-span-2 flex items-end">
                        <button onclick="saveCloudConfig()" class="w-full bg-amber-500 hover:bg-amber-600 text-slate-900 font-black py-2 px-4 rounded-xl text-xs transition">
                            حفظ وربط
                        </button>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <div class="lg:col-span-5">
                    <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm sticky top-20">
                        <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
                            <h2 id="form-title" class="font-black text-lg text-slate-800 flex items-center gap-2">
                                <i data-lucide="plus-circle" class="w-5 h-5 text-amber-500"></i>
                                <span>إضافة منتج جديد</span>
                            </h2>
                            <button type="button" id="cancel-edit-btn" onclick="resetProductForm()" class="hidden text-xs font-bold text-red-600 bg-red-50 px-3 py-1.5 rounded-lg hover:bg-red-100">
                                إلغاء التعديل
                            </button>
                        </div>

