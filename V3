    </main>

    <!-- شريط التنقل السفلي للموبايل (Bottom Navigation) -->
    <nav class="md:hidden fixed bottom-0 left-0 right-0 bg-slate-900 text-white border-t border-slate-800 z-40 px-2 py-1.5 grid grid-cols-3 gap-1 shadow-2xl">
