                            <button type="submit" id="submit-prod-btn" class="w-full bg-amber-500 hover:bg-amber-600 active:scale-98 text-slate-900 font-black py-3.5 rounded-xl shadow-md transition flex items-center justify-center gap-2 text-base">
                                <i data-lucide="save" class="w-5 h-5"></i>
                                <span>حفظ المنتج</span>
                            </button>
                        </form>
                    </div>
                </div>

                <!-- قائمة المنتجات الحالية للتعديل والحذف -->
                <div class="lg:col-span-7 space-y-3">
                    <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <h3 class="font-black text-base text-slate-800">قائمة المنتجات المتوفرة (<span id="manage-total-count">0</span>)</h3>
                        <input type="text" id="manage-search" oninput="renderManageProducts()" placeholder="بحث في المنتجات..." class="bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 text-xs font-bold focus:outline-none focus:ring-2 focus:ring-amber-500">
                    </div>

                    <div id="manage-products-list" class="space-y-2.5">
                        <!-- يتم تعبئة المنتجات عبر JS -->
