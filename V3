    <!-- ========================================== -->
    <!-- إشعار سريع مع زر تراجع (Toast Notification) -->
    <!-- ========================================== -->
    <div id="toast-container" class="fixed bottom-20 md:bottom-6 left-4 right-4 md:left-auto md:right-6 z-50 pointer-events-none flex flex-col gap-2 items-center md:items-end">
        <!-- يظهر الإشعار هنا -->
    </div>

    <script>
        // ==========================================
        // 1. إدارة الحالة والبيانات (State Management)
        // ==========================================
        const STORAGE_KEYS = {
            PRODUCTS: 'dukhaniyat_products_v3',
            SALES: 'dukhaniyat_sales_v2',
            SOUND: 'dukhaniyat_sound_v1'
        };

        const INITIAL_PRODUCTS = [
            {
                id: 'p_101', name: 'فوزل 40K', category: 'فيب', cost: 10000, price: 13000,
                image: 'https://example.com/apple-shisha.jpg'
            },
            {
                id: 'p_102', name: 'فوزل 12K', category: 'فيب', cost: 4500, price: 6000,
                image: null
            },
            {
                id: 'p_103', name: 'اسم المنتج الجديد', category: 'فيب', cost: 8000, price: 11000,
              image: 'https://example.com/product.jpg'
            }

        ];

        let products = [];
        let sales = []; // { id, productId, name, cost, price, timestamp, dateStr }
        let currentPOSCategory = 'الكل';
        let currentReportPeriod = 'daily'; // daily, weekly, monthly
        let soundEnabled = true;

        // ==========================================
        // 2. دوال التاريخ والعملة (Utilities)
        // ==========================================
        const ARABIC_DAYS = ['الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'];

        // الحصول على تاريخ اليوم بصيغة YYYY-MM-DD حسب التوقيت المحلي
        function getLocalDateStr(dateObj = new Date()) {
            const year = dateObj.getFullYear();
            const month = String(dateObj.getMonth() + 1).padStart(2, '0');
            const day = String(dateObj.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        // تنسيق التاريخ العربي: "الأحد 11/15"
        function formatArabicDayMonth(dateStr) {
            const [y, m, d] = dateStr.split('-').map(Number);
            const dateObj = new Date(y, m - 1, d);
            const dayName = ARABIC_DAYS[dateObj.getDay()];
            return `${dayName} ${m}/${d}`;
        }

        // تنسيق التاريخ الكامل: "الأحد 15/11/2026"
        function formatFullArabicDate(dateStr) {
            const [y, m, d] = dateStr.split('-').map(Number);
            const dateObj = new Date(y, m - 1, d);
            const dayName = ARABIC_DAYS[dateObj.getDay()];
            return `${dayName} ${d}/${m}/${y}`;
        }

        // تنسيق العملة بالدينار العراقي
        function formatIQD(amount) {
            return Number(amount || 0).toLocaleString('en-US') + ' د.ع';
        }

        // صوت نقرة لطيفة عند البيع باستخدام Tone.js
        function playSaleSound() {
            if (!soundEnabled) return;
            try {
                if (Tone.context.state !== 'running') {
                    Tone.start();
                }
                const synth = new Tone.Synth({
                    oscillator: { type: 'sine' },
                    envelope: { attack: 0.005, decay: 0.1, sustain: 0, release: 0.1 }
                }).toDestination();
                synth.triggerAttackRelease('C6', '32n');
            } catch (e) {
                // تجاهل أخطاء الصوت في حال عدم تفاعل المستخدم
            }
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            localStorage.setItem(STORAGE_KEYS.SOUND, JSON.stringify(soundEnabled));
            updateSoundIcon();
            showToast(soundEnabled ? 'تم تفعيل صوت النقر' : 'تم كتم الصوت');
        }

        function updateSoundIcon() {
            const btn = document.getElementById('sound-toggle-btn');
            btn.innerHTML = soundEnabled 
                ? '<i data-lucide="volume-2" class="w-5 h-5"></i>' 
                : '<i data-lucide="volume-x" class="w-5 h-5 text-slate-400"></i>';
            lucide.createIcons();
        }

        // ==========================================
        // 3. تهيئة التطبيق وحفظ البيانات
        // ==========================================
        function initApp() {
            // تحميل المنتجات مباشرة من مصفوفة الكود في كل مرة تُعاد فيها تحميل الصفحة
            products = [...INITIAL_PRODUCTS];
            saveProducts();

            // تحميل المبيعات
            const savedSales = localStorage.getItem(STORAGE_KEYS.SALES);
            sales = savedSales ? JSON.parse(savedSales) : [];

            // تحميل إعداد الصوت
            const savedSound = localStorage.getItem(STORAGE_KEYS.SOUND);
            if (savedSound !== null) {
                soundEnabled = JSON.parse(savedSound);
            }
            updateSoundIcon();

            // ضبط تواريخ الواجهة
            const todayStr = getLocalDateStr();
            document.getElementById('header-date').textContent = formatFullArabicDate(todayStr);
            document.getElementById('report-date-input').value = todayStr;

            // عرض الواجهات
            renderPOSProducts();
            updatePOSTodaySummary();
            renderManageProducts();
            lucide.createIcons();
        }

        function saveProducts() {
            localStorage.setItem(STORAGE_KEYS.PRODUCTS, JSON.stringify(products));
        }

        function saveSales() {
            localStorage.setItem(STORAGE_KEYS.SALES, JSON.stringify(sales));
            updatePOSTodaySummary();
        }

        // ==========================================
        // 4. التنقل بين الأقسام الثلاثة
        // ==========================================
        function switchTab(tabName) {
            ['pos', 'inventory', 'manage'].forEach(t => {
                document.getElementById(`tab-${t}`).classList.add('hidden');
            });
            document.getElementById(`tab-${tabName}`).classList.remove('hidden');

            // تحديث أزرار سطح المكتب
            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('bg-amber-500', 'text-slate-900', 'shadow');
                btn.classList.add('text-slate-300', 'hover:text-white', 'hover:bg-slate-700');
            });
            const activeDesktop = document.getElementById(`nav-desktop-${tabName}`);
            activeDesktop.classList.remove('text-slate-300', 'hover:text-white', 'hover:bg-slate-700');
            activeDesktop.classList.add('bg-amber-500', 'text-slate-900', 'shadow');

            // تحديث أزرار الموبايل
            document.querySelectorAll('.mob-nav-btn').forEach(btn => {
                btn.classList.remove('text-amber-400', 'bg-slate-800');
                btn.classList.add('text-slate-400');
            });
            const activeMobile = document.getElementById(`nav-mobile-${tabName}`);
            activeMobile.classList.remove('text-slate-400');
            activeMobile.classList.add('text-amber-400', 'bg-slate-800');

            // تحديث البيانات حسب الصفحة المفتوحة
            if (tabName === 'pos') {
                renderPOSProducts();
                updatePOSTodaySummary();
            } else if (tabName === 'inventory') {
                renderInventoryReport();
            } else if (tabName === 'manage') {
                renderManageProducts();
            }
            lucide.createIcons();
        }

        // ==========================================
        // 5. منطق واجهة البيع السريع (POS)
        // ==========================================
        function setPOSCategory(category) {
            currentPOSCategory = category;
            document.querySelectorAll('.cat-btn').forEach(btn => {
                if (btn.textContent.includes(category)) {
                    btn.classList.remove('bg-slate-100', 'text-slate-600');
                    btn.classList.add('bg-amber-500', 'text-slate-900', 'shadow-sm');
                } else {
                    btn.classList.remove('bg-amber-500', 'text-slate-900', 'shadow-sm');
                    btn.classList.add('bg-slate-100', 'text-slate-600');
                }
            });
            renderPOSProducts();
        }

        function renderPOSProducts() {
            const grid = document.getElementById('pos-products-grid');
            const emptyState = document.getElementById('pos-empty-state');
            const emptyText = document.getElementById('pos-empty-text');
            const searchQuery = document.getElementById('pos-search').value.trim().toLowerCase();

            const filtered = products.filter(p => {
                const matchCat = currentPOSCategory === 'الكل' || p.category === currentPOSCategory;
                const matchSearch = p.name.toLowerCase().includes(searchQuery);
                return matchCat && matchSearch;
            });

            if (filtered.length === 0) {
                grid.innerHTML = '';
                emptyText.textContent = products.length === 0
                    ? 'لا توجد منتجات مضافة بعد، ابدأ بإضافة منتجاتك الحقيقية'
                    : 'لا توجد منتجات مطابقة لبحثك';
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');
            grid.innerHTML = filtered.map(product => {
                const visual = product.image 
                    ? `<div class="w-full h-28 sm:h-32 rounded-xl mb-2.5 bg-slate-100 overflow-hidden flex items-center justify-center">
                           <img src="${product.image}" alt="${product.name}" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" class="w-full h-full object-cover">
                           <div style="display:none;" class="w-full h-full bg-gradient-to-br from-slate-100 to-slate-200 items-center justify-center text-slate-400">
                               <i data-lucide="package" class="w-10 h-10"></i>
                           </div>
                       </div>`
                    : `<div class="w-full h-28 sm:h-32 rounded-xl mb-2.5 bg-gradient-to-br from-slate-100 to-slate-200 flex items-center justify-center text-slate-400 shadow-inner">
                           <i data-lucide="package" class="w-10 h-10"></i>
                       </div>`;

                return `
                    <button onclick="recordSale('${product.id}')" class="product-card bg-white hover:border-amber-500 border-2 border-slate-200/80 rounded-2xl p-3 text-right shadow-sm hover:shadow-md transition-all flex flex-col justify-between group relative overflow-hidden">
                        <span class="absolute top-2 left-2 bg-slate-900/80 backdrop-blur-sm text-white text-[10px] font-bold px-2 py-0.5 rounded-lg z-10">
                            ${product.category}
                        </span>
                        <div class="w-full">
                            ${visual}
                            <h3 class="font-extrabold text-sm sm:text-base text-slate-800 leading-snug line-clamp-2 group-hover:text-amber-700 transition">
                                ${product.name}
                            </h3>
                        </div>
                        <div class="mt-3 pt-2 border-t border-slate-100 flex items-center justify-between w-full">
                            <span class="font-black text-base sm:text-lg text-emerald-600">${formatIQD(product.price)}</span>
                            <span class="w-8 h-8 rounded-xl bg-amber-100 text-amber-700 group-hover:bg-amber-500 group-hover:text-slate-900 flex items-center justify-center transition">
                                <i data-lucide="plus" class="w-5 h-5"></i>
                            </span>
                        </div>
                    </button>
                `;
            }).join('');

            lucide.createIcons();
        }

        // تسجيل عملية بيع بضغطة واحدة
        function recordSale(productId) {
            const product = products.find(p => p.id === productId);
            if (!product) return;

            const saleRecord = {
                id: 's_' + Date.now() + '_' + Math.random().toString(36).substr(2, 4),
                productId: product.id,
                name: product.name,
                cost: Number(product.cost),
                price: Number(product.price),
                timestamp: Date.now(),
                dateStr: getLocalDateStr()
            };

            sales.push(saleRecord);
            saveSales();
            playSaleSound();

            showToast(`تم بيع: ${product.name} (${formatIQD(product.price)})`, saleRecord.id);
        }

        // التراجع عن عملية بيع
        function undoSale(saleId, toastElement) {
            const index = sales.findIndex(s => s.id === saleId);
            if (index !== -1) {
                sales.splice(index, 1);
                saveSales();
                if (toastElement) toastElement.remove();
                showToast('تم التراجع وإلغاء البيع بنجاح');
                if (!document.getElementById('today-sales-modal').classList.contains('hidden')) {
                    renderTodaySalesModalList();
                }
            }
        }

        function updatePOSTodaySummary() {
            const todayStr = getLocalDateStr();
            const todaySales = sales.filter(s => s.dateStr === todayStr);
            const totalAmount = todaySales.reduce((sum, item) => sum + item.price, 0);

            document.getElementById('pos-today-total').textContent = formatIQD(totalAmount);
            document.getElementById('pos-today-count').textContent = todaySales.length + ' قطعة';
        }

        // ==========================================
        // 6. نافذة سجل مبيعات اليوم (للتعديل السريع)
        // ==========================================
        function openTodaySalesModal() {
            const todayStr = getLocalDateStr();
            document.getElementById('modal-today-date').textContent = formatFullArabicDate(todayStr);
            renderTodaySalesModalList();
            document.getElementById('today-sales-modal').classList.remove('hidden');
            lucide.createIcons();
        }

        function closeTodaySalesModal() {
            document.getElementById('today-sales-modal').classList.add('hidden');
        }

        function renderTodaySalesModalList() {
            const todayStr = getLocalDateStr();
            const todaySales = sales.filter(s => s.dateStr === todayStr);
            const listEl = document.getElementById('today-sales-list');
            const totalEl = document.getElementById('modal-today-total');

            const totalAmount = todaySales.reduce((sum, s) => sum + s.price, 0);
            totalEl.textContent = formatIQD(totalAmount);

            if (todaySales.length === 0) {
                listEl.innerHTML = `<div class="text-center py-8 text-slate-400 font-bold">لم يتم تسجيل أي مبيعات اليوم بعد.</div>`;
                return;
            }

            const grouped = {};
            todaySales.forEach(s => {
                if (!grouped[s.productId]) {
                    grouped[s.productId] = {
                        productId: s.productId,
                        name: s.name,
                        price: s.price,
                        count: 0,
                        saleIds: []
                    };
                }
                grouped[s.productId].count += 1;
                grouped[s.productId].saleIds.push(s.id);
            });

            listEl.innerHTML = Object.values(grouped).map(item => `
                <div class="bg-slate-50 border border-slate-200 rounded-2xl p-3 flex items-center justify-between gap-2">
                    <div class="flex-1">
                        <h4 class="font-extrabold text-sm text-slate-800">${item.name}</h4>
                        <span class="text-xs text-slate-500 font-bold">سعر القطعة: ${formatIQD(item.price)}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="decreaseTodayProduct('${item.productId}')" class="w-8 h-8 rounded-xl bg-red-100 text-red-600 hover:bg-red-200 flex items-center justify-center font-black">
                            <i data-lucide="minus" class="w-4 h-4"></i>
                        </button>
                        <span class="w-8 text-center font-black text-base text-slate-900">${item.count}</span>
                        <button onclick="increaseTodayProduct('${item.productId}')" class="w-8 h-8 rounded-xl bg-emerald-100 text-emerald-700 hover:bg-emerald-200 flex items-center justify-center font-black">
                            <i data-lucide="plus" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>
            `).join('');

            lucide.createIcons();
        }

        function increaseTodayProduct(productId) {
            recordSale(productId);
            renderTodaySalesModalList();
        }

        function decreaseTodayProduct(productId) {
            const todayStr = getLocalDateStr();
            for (let i = sales.length - 1; i >= 0; i--) {
                if (sales[i].dateStr === todayStr && sales[i].productId === productId) {
                    sales.splice(i, 1);
                    saveSales();
                    renderTodaySalesModalList();
                    break;
                }
            }
        }

        // ==========================================
        // 7. منطق الجرد والتقارير (يومي، أسبوعي، شهري)
        // ==========================================
        function setReportPeriod(period) {
            currentReportPeriod = period;
            
            document.querySelectorAll('.rep-tab').forEach(btn => {
                btn.classList.remove('bg-white', 'text-slate-900', 'shadow');
                btn.classList.add('text-slate-600');
            });
            const activeTab = document.getElementById(`rep-tab-${period}`);
            activeTab.classList.remove('text-slate-600');
            activeTab.classList.add('bg-white', 'text-slate-900', 'shadow');

            const datePickerWrap = document.getElementById('daily-date-picker-wrap');
            if (period === 'daily') {
                datePickerWrap.classList.remove('hidden');
            } else {
                datePickerWrap.classList.add('hidden');
            }

            renderInventoryReport();
        }

        function renderInventoryReport() {
            const selectedDateStr = document.getElementById('report-date-input').value || getLocalDateStr();
            const titleEl = document.getElementById('report-dynamic-title');
            const subtitleEl = document.getElementById('report-period-subtitle');

            let filteredSales = [];

            if (currentReportPeriod === 'daily') {
                titleEl.textContent = `الجرد ليوم ${formatArabicDayMonth(selectedDateStr)}`;
                subtitleEl.textContent = formatFullArabicDate(selectedDateStr);
                filteredSales = sales.filter(s => s.dateStr === selectedDateStr);

            } else if (currentReportPeriod === 'weekly') {
                const end = new Date();
                const start = new Date();
                start.setDate(end.getDate() - 6);
                
                const startStr = getLocalDateStr(start);
                const endStr = getLocalDateStr(end);

                titleEl.textContent = 'الجرد الأسبوعي (آخر 7 أيام)';
                subtitleEl.textContent = `من ${formatArabicDayMonth(startStr)} إلى ${formatArabicDayMonth(endStr)}`;

                filteredSales = sales.filter(s => s.dateStr >= startStr && s.dateStr <= endStr);

            } else if (currentReportPeriod === 'monthly') {
                const now = new Date();
                const yearMonth = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
                const arabicMonths = ['كانون الثاني', 'شباط', 'آذار', 'نيسان', 'أيار', 'حزيران', 'تموز', 'آب', 'أيلول', 'تشرين الأول', 'تشرين الثاني', 'كانون الأول'];
                
                titleEl.textContent = `الجرد الشهري - شهر ${arabicMonths[now.getMonth()]}`;
                subtitleEl.textContent = `${now.getMonth() + 1} / ${now.getFullYear()}`;

                filteredSales = sales.filter(s => s.dateStr.startsWith(yearMonth));
            }

            let totalSales = 0;
            let totalCost = 0;
            const totalItems = filteredSales.length;
            const productSummary = {};

            filteredSales.forEach(s => {
                totalSales += s.price;
                totalCost += s.cost;

                if (!productSummary[s.name]) {
                    productSummary[s.name] = {
                        name: s.name,
                        qty: 0,
                        costTotal: 0,
                        salesTotal: 0,
                        profitTotal: 0
                    };
                }
                productSummary[s.name].qty += 1;
                productSummary[s.name].costTotal += s.cost;
                productSummary[s.name].salesTotal += s.price;
                productSummary[s.name].profitTotal += (s.price - s.cost);
            });

            const netProfit = totalSales - totalCost;

            document.getElementById('stat-total-sales').textContent = formatIQD(totalSales);
            document.getElementById('stat-total-cost').textContent = formatIQD(totalCost);
            document.getElementById('stat-net-profit').textContent = formatIQD(netProfit);
            document.getElementById('stat-total-items').textContent = `${totalItems} قطعة`;

            const tbody = document.getElementById('report-table-body');
            const emptyState = document.getElementById('report-empty-state');
            const summaryList = Object.values(productSummary).sort((a, b) => b.qty - a.qty);

            if (summaryList.length === 0) {
                tbody.innerHTML = '';
                emptyState.classList.remove('hidden');
            } else {
                emptyState.classList.add('hidden');
                tbody.innerHTML = summaryList.map(row => `
                    <tr class="hover:bg-slate-50 transition">
                        <td class="py-3.5 px-4 font-bold text-slate-800">${row.name}</td>
                        <td class="py-3.5 px-3 text-center">
                            <span class="bg-slate-100 text-slate-800 font-black px-2.5 py-1 rounded-lg text-xs">${row.qty}</span>
                        </td>
                        <td class="py-3.5 px-4 font-semibold text-slate-600">${formatIQD(row.costTotal)}</td>
                        <td class="py-3.5 px-4 font-bold text-slate-900">${formatIQD(row.salesTotal)}</td>
                        <td class="py-3.5 px-4 font-black text-emerald-600">${formatIQD(row.profitTotal)}</td>
                    </tr>
                `).join('');
            }
        }

        // مشاركة ملخص الجرد كنص للواتساب
        function shareReportWhatsApp() {
            const title = document.getElementById('report-dynamic-title').textContent;
            const totalSales = document.getElementById('stat-total-sales').textContent;
            const totalCost = document.getElementById('stat-total-cost').textContent;
            const netProfit = document.getElementById('stat-net-profit').textContent;
            const totalItems = document.getElementById('stat-total-items').textContent;

            let text = `*${title}*\n`;
            text += `------------------------\n`;
            text += `إجمالي المبيعات: ${totalSales}\n`;
            text += `رأس المال (التكلفة): ${totalCost}\n`;
            text += `*صافي الربح: ${netProfit}*\n`;
            text += `عدد القطع المباعة: ${totalItems}\n`;
            text += `------------------------\n`;

            const rows = document.querySelectorAll('#report-table-body tr');
            if (rows.length > 0) {
                text += `*التفاصيل:*\n`;
                rows.forEach(tr => {
                    const cols = tr.querySelectorAll('td');
                    text += `• ${cols[0].textContent} (العدد: ${cols[1].textContent.trim()}) = ${cols[3].textContent}\n`;
                });
            }

            const textarea = document.createElement('textarea');
            textarea.value = text;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);

            showToast('تم نسخ تقرير الجرد! يمكنك لصقه الآن في الواتساب');
        }

        // ==========================================
        // 8. إدارة المنتجات (إضافة، تعديل، حذف، رابط صورة)
        // ==========================================
        function calculateLiveProfit() {
            const cost = Number(document.getElementById('prod-cost').value) || 0;
            const price = Number(document.getElementById('prod-price').value) || 0;
            const profit = price - cost;
            const previewEl = document.getElementById('live-profit-preview');
            
            previewEl.textContent = formatIQD(profit);
            if (profit < 0) {
                previewEl.classList.remove('text-emerald-600');
                previewEl.classList.add('text-red-600');
            } else {
                previewEl.classList.remove('text-red-600');
                previewEl.classList.add('text-emerald-600');
            }
        }

        function setDefaultPreviewBox() {
            const box = document.getElementById('image-preview-box');
            box.innerHTML = `<i data-lucide="image" class="w-6 h-6"></i>`;
            lucide.createIcons();
        }

        function handleImageUrlInput() {
            const url = document.getElementById('prod-image-url').value.trim();
            const clearBtn = document.getElementById('clear-img-btn');
            const previewBox = document.getElementById('image-preview-box');

            if (url) {
                clearBtn.classList.remove('hidden');
                previewBox.innerHTML = `<img src="${url}" onerror="setDefaultPreviewBox()" class="w-full h-full object-cover">`;
            } else {
                clearBtn.classList.add('hidden');
                setDefaultPreviewBox();
            }
        }

        function clearProductImage() {
            document.getElementById('prod-image-url').value = '';
            document.getElementById('clear-img-btn').classList.add('hidden');
            setDefaultPreviewBox();
        }

        function handleProductSubmit(event) {
            event.preventDefault();
            
            const id = document.getElementById('prod-id').value;
            const name = document.getElementById('prod-name').value.trim();
            const category = document.getElementById('prod-category').value;
            const cost = Number(document.getElementById('prod-cost').value);
            const price = Number(document.getElementById('prod-price').value);
            const imageUrl = document.getElementById('prod-image-url').value.trim() || null;

            if (!name) return;

            if (id) {
                // تعديل منتج موجود
                const index = products.findIndex(p => p.id === id);
                if (index !== -1) {
                    products[index] = {
                        ...products[index],
                        name,
                        category,
                        cost,
                        price,
                        image: imageUrl
                    };
                    showToast('تم تحديث بيانات المنتج بنجاح');
                }
            } else {
                // إضافة منتج جديد
                const newProduct = {
                    id: 'p_' + Date.now(),
                    name,
                    category,
                    cost,
                    price,
                    image: imageUrl
                };
                products.unshift(newProduct);
                showToast('تمت إضافة المنتج الجديد بنجاح');
            }

            saveProducts();
            resetProductForm();
            renderManageProducts();
            renderPOSProducts();
        }

        function editProduct(id) {
            const product = products.find(p => p.id === id);
            if (!product) return;

            document.getElementById('prod-id').value = product.id;
            document.getElementById('prod-name').value = product.name;
            document.getElementById('prod-category').value = product.category;
            document.getElementById('prod-cost').value = product.cost;
            document.getElementById('prod-price').value = product.price;
            document.getElementById('prod-image-url').value = product.image || '';

            handleImageUrlInput();
            calculateLiveProfit();

            document.getElementById('form-title').innerHTML = `<i data-lucide="edit-3" class="w-5 h-5 text-amber-500"></i><span>تعديل المنتج</span>`;
            document.getElementById('submit-prod-btn').innerHTML = `<i data-lucide="check-circle" class="w-5 h-5"></i><span>حفظ التعديلات</span>`;
            document.getElementById('cancel-edit-btn').classList.remove('hidden');
            lucide.createIcons();

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function resetProductForm() {
            document.getElementById('product-form').reset();
            document.getElementById('prod-id').value = '';
            clearProductImage();
            document.getElementById('live-profit-preview').textContent = '0 د.ع';
            document.getElementById('form-title').innerHTML = `<i data-lucide="plus-circle" class="w-5 h-5 text-amber-500"></i><span>إضافة منتج جديد</span>`;
            document.getElementById('submit-prod-btn').innerHTML = `<i data-lucide="save" class="w-5 h-5"></i><span>حفظ المنتج</span>`;
            document.getElementById('cancel-edit-btn').classList.add('hidden');
            lucide.createIcons();
        }

        function confirmDeleteProduct(id) {
            const product = products.find(p => p.id === id);
            if (!product) return;

            openConfirmModal(
                'حذف المنتج',
                `هل أنت متأكد من حذف "${product.name}"؟ (لن تتأثر سجلات الجرد السابقة لهذا المنتج).`,
                () => {
                    products = products.filter(p => p.id !== id);
                    saveProducts();
                    renderManageProducts();
                    renderPOSProducts();
                    showToast('تم حذف المنتج');
                }
            );
        }

        function renderManageProducts() {
            const listEl = document.getElementById('manage-products-list');
            const search = document.getElementById('manage-search').value.trim().toLowerCase();
            
            const filtered = products.filter(p => p.name.toLowerCase().includes(search) || p.category.includes(search));
            document.getElementById('manage-total-count').textContent = products.length;

            if (filtered.length === 0) {
                const msg = products.length === 0
                    ? 'لا توجد منتجات حالياً. أضف أول منتج حقيقي من النموذج.'
                    : 'لا توجد منتجات مطابقة لبحثك.';
                listEl.innerHTML = `<div class="bg-white rounded-2xl p-8 text-center text-slate-400 font-bold border border-slate-200">${msg}</div>`;
                return;
            }

            listEl.innerHTML = filtered.map(p => {
                const profit = p.price - p.cost;
                const thumb = p.image 
                    ? `<div class="w-14 h-14 rounded-xl bg-slate-100 shrink-0 overflow-hidden flex items-center justify-center">
                           <img src="${p.image}" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" class="w-full h-full object-cover">
                           <div style="display:none;" class="w-full h-full items-center justify-center text-slate-400">
                               <i data-lucide="package" class="w-6 h-6"></i>
                           </div>
                       </div>`
                    : `<div class="w-14 h-14 rounded-xl bg-slate-100 flex items-center justify-center text-slate-400 shrink-0">
                           <i data-lucide="package" class="w-6 h-6"></i>
                       </div>`;

                return `
                    <div class="bg-white rounded-2xl p-3.5 border border-slate-200 shadow-sm flex items-center justify-between gap-3 hover:border-slate-300 transition">
                        <div class="flex items-center gap-3 min-w-0">
                            ${thumb}
                            <div class="min-w-0">
                                <span class="text-[11px] font-bold text-amber-600 bg-amber-50 px-2 py-0.5 rounded-md">${p.category}</span>
                                <h4 class="font-extrabold text-sm sm:text-base text-slate-800 truncate mt-0.5">${p.name}</h4>
                                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs mt-1">
                                    <span class="text-slate-500 font-semibold">الشراء: <b class="text-slate-700">${formatIQD(p.cost)}</b></span>
                                    <span class="text-slate-500 font-semibold">البيع: <b class="text-blue-600">${formatIQD(p.price)}</b></span>
                                    <span class="text-emerald-600 font-extrabold">الربح: ${formatIQD(profit)}</span>
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center gap-1.5 shrink-0">
                            <button onclick="editProduct('${p.id}')" title="تعديل" class="p-2.5 rounded-xl bg-blue-50 text-blue-600 hover:bg-blue-100 transition">
                                <i data-lucide="edit-2" class="w-4 h-4"></i>
                            </button>
                            <button onclick="confirmDeleteProduct('${p.id}')" title="حذف" class="p-2.5 rounded-xl bg-red-50 text-red-600 hover:bg-red-100 transition">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');

            lucide.createIcons();
        }

        // ==========================================
        // 9. النسخ الاحتياطي والاستعادة (JSON)
        // ==========================================
        function exportBackupJSON() {
            const backupData = {
                app: 'DukhaniyatPOS',
                exportDate: new Date().toISOString(),
                products,
                sales
            };

            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(backupData, null, 2));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", `جرد_ومنتجات_المحل_${getLocalDateStr()}.json`);
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();

            showToast('تم تحميل ملف النسخة الاحتياطية بنجاح');
        }

        function importBackupJSON(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const data = JSON.parse(e.target.result);
                    if (data && Array.isArray(data.products) && Array.isArray(data.sales)) {
                        products = data.products;
                        sales = data.sales;
                        saveProducts();
                        saveSales();
                        renderManageProducts();
                        renderPOSProducts();
                        showToast('تمت استعادة البيانات والمنتجات بنجاح!');
                    } else {
                        showToast('ملف النسخة الاحتياطية غير صالح');
                    }
                } catch (err) {
                    showToast('حدث خطأ أثناء قراءة الملف');
                }
                event.target.value = '';
            };
            reader.readAsText(file);
        }

        // ==========================================
        // 10. الإشعارات ونوافذ التأكيد (UI Helpers)
        // ==========================================
        function showToast(message, undoSaleId = null) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = 'pointer-events-auto bg-slate-900 text-white px-4 py-3 rounded-2xl shadow-xl border border-slate-700 flex items-center gap-3 text-sm font-bold max-w-md w-full sm:w-auto justify-between transition-all';
            
            let html = `
                <div class="flex items-center gap-2.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shrink-0"></span>
                    <span>${message}</span>
                </div>
            `;

            if (undoSaleId) {
                html += `<button class="undo-btn bg-amber-500 hover:bg-amber-600 text-slate-900 px-3 py-1 rounded-xl text-xs font-black shrink-0 transition">تراجع</button>`;
            }

            toast.innerHTML = html;

            if (undoSaleId) {
                toast.querySelector('.undo-btn').onclick = () => undoSale(undoSaleId, toast);
            }

            if (container.children.length >= 2) {
                container.firstElementChild.remove();
            }

            container.appendChild(toast);

            setTimeout(() => {
                if (toast.parentElement) {
                    toast.style.opacity = '0';
                    setTimeout(() => toast.remove(), 300);
                }
            }, undoSaleId ? 4500 : 2500);
        }

        function openConfirmModal(title, message, onConfirm) {
            document.getElementById('confirm-title').textContent = title;
            document.getElementById('confirm-message').textContent = message;
            const actionBtn = document.getElementById('confirm-action-btn');
            actionBtn.onclick = () => {
                onConfirm();
                closeConfirmModal();
            };
            document.getElementById('confirm-modal').classList.remove('hidden');
        }

        function closeConfirmModal() {
            document.getElementById('confirm-modal').classList.add('hidden');
        }

        // حفظ تقرير الجرد كصورة مباشرة
        function saveReportAsImage() {
            const reportArea = document.getElementById('printable-report');
            if (!reportArea) return;
            showToast('جاري حفظ صورة التقرير...');
            html2canvas(reportArea, {
                scale: 2,
                backgroundColor: '#f1f5f9',
                useCORS: true,
                onclone: (clonedDoc) => {
                    const clonedReport = clonedDoc.getElementById('printable-report');
                    if (clonedReport) {
                        clonedReport.style.letterSpacing = '0px';
                        clonedReport.querySelectorAll('*').forEach(el => {
                            el.style.letterSpacing = '0px';
                        });
                    }
                }
            }).then(canvas => {
                const link = document.createElement('a');
                const dateStr = document.getElementById('report-date-input').value || getLocalDateStr();
                link.download = `جرد_عالم_الدخان_${dateStr}.png`;
                link.href = canvas.toDataURL('image/png');
                link.click();
                showToast('تم حفظ صورة الجرد بنجاح!');
            }).catch(() => {
                showToast('حدث خطأ أثناء حفظ الصورة');
            });
        }

        // إزالة شارة Netlify تلقائياً بجميع الطرق
        (function removeNetlifyBadge() {
            const appIds = new Set(['tab-pos', 'tab-inventory', 'tab-manage', 'today-sales-modal', 'confirm-modal', 'toast-container']);
            const clean = () => {
                document.querySelectorAll('iframe, a, div, aside, section').forEach(el => {
                    if (appIds.has(el.id)) return;
                    const src = (el.getAttribute('src') || '').toLowerCase();
                    const href = (el.getAttribute('href') || '').toLowerCase();
                    const id = (el.id || '').toLowerCase();
                    const cls = (typeof el.className === 'string' ? el.className : '').toLowerCase();
                    const text = (el.textContent || '').trim();

                    if (
                        src.includes('netlify') ||
                        href.includes('netlify') ||
                        id.includes('netlify') ||
                        cls.includes('netlify') ||
                        text === 'Powered by Netlify'
                    ) {
                        const wrapper = el.closest('body > div, body > aside, body > iframe');
                        if (wrapper && !appIds.has(wrapper.id) && wrapper.tagName !== 'HEADER' && wrapper.tagName !== 'MAIN' && wrapper.tagName !== 'NAV') {
                            wrapper.remove();
                        } else {
                            el.remove();
                        }
                    }
                });

                [document.documentElement, document.body].forEach(root => {
                    if (!root) return;
                    Array.from(root.children).forEach(child => {
                        const tag = child.tagName;
                        if (['HEAD', 'BODY', 'HEADER', 'MAIN', 'NAV', 'SCRIPT', 'STYLE', 'LINK'].includes(tag)) return;
                        if (appIds.has(child.id)) return;
                        const shadowText = child.shadowRoot ? (child.shadowRoot.innerHTML || '').toLowerCase() : '';
                        const outer = (child.outerHTML || '').toLowerCase();
                        if (shadowText.includes('netlify') || outer.includes('netlify') || child.shadowRoot) {
                            child.remove();
                        }
                    });
                });
            };

            clean();
            setInterval(clean, 500);
            const observer = new MutationObserver(clean);
            observer.observe(document.documentElement, { childList: true, subtree: true });
        })();

        // تشغيل التطبيق عند اكتمال التحميل
        window.onload = initApp;
    </script>
